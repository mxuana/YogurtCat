<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout android:id="@+id/mainContent" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/sessions" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="46dp" android:layout_height="46dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="☰" android:textColor="@color/ink" android:textSize="23sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="酸奶喵" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/drawerNewSession" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp"
                android:contentDescription="新建会话" android:text="＋" android:textColor="@color/ink" android:textSize="24sp"/>
        </LinearLayout>

        <ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/historyContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="16dp"/>
        </ScrollView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/composerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="24dp" app:cardElevation="1dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="6dp">
                <HorizontalScrollView android:id="@+id/referenceScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:scrollbars="none">
                    <LinearLayout android:id="@+id/referenceContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView android:id="@+id/referenceHint" android:layout_width="wrap_content" android:layout_height="1dp" android:visibility="gone" android:text=""/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp">
                    <Spinner android:id="@+id/model" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1.7" android:contentDescription="模型" android:dropDownWidth="wrap_content"
                        android:layout_marginHorizontal="2dp" android:background="@drawable/bg_parameter_chip"/>
                    <Spinner android:id="@+id/aspectRatio" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="0.8" android:contentDescription="比例" android:dropDownWidth="wrap_content"
                        android:layout_marginHorizontal="2dp" android:background="@drawable/bg_parameter_chip"/>
                    <Spinner android:id="@+id/resolution" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="0.7" android:contentDescription="分辨率" android:dropDownWidth="wrap_content"
                        android:layout_marginHorizontal="2dp" android:background="@drawable/bg_parameter_chip"/>
                    <Spinner android:id="@+id/relay" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1.4" android:contentDescription="中转站" android:dropDownWidth="wrap_content"
                        android:layout_marginHorizontal="2dp" android:background="@drawable/bg_parameter_chip"/>
                </LinearLayout>
                <TextView android:id="@+id/modelStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp" android:textColor="@color/muted" android:textSize="11sp" android:visibility="gone"/>
                <TextView android:id="@+id/sizeHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp" android:textColor="@color/muted" android:textSize="11sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/addReferences" style="@style/Widget.Material3.Button.TextButton" android:layout_width="42dp" android:layout_height="42dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:contentDescription="从相册添加参考图" android:text="＋" android:textSize="24sp" android:textColor="@color/ink"/>
                    <EditText android:id="@+id/prompt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:maxHeight="150dp" android:background="@android:color/transparent" android:gravity="center_vertical|start" android:hint="描述你想生成的图片…" android:inputType="textCapSentences|textMultiLine" android:padding="8dp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="16sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/generate" android:layout_width="46dp" android:layout_height="46dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" android:text="↑" android:textSize="24sp" android:textColor="@android:color/white" android:stateListAnimator="@animator/press_scale" app:backgroundTint="#181818" app:cornerRadius="23dp"/>
                </LinearLayout>
                <TextView android:id="@+id/status" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginTop="2dp" android:textColor="@color/muted" android:textSize="11sp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/clearReferences" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" android:text=""/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
            <View android:id="@+id/resultCard" android:layout_width="1dp" android:layout_height="1dp"/>
            <ImageView android:id="@+id/image" android:layout_width="1dp" android:layout_height="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="1dp" android:layout_height="1dp" android:text=""/>
            <ProgressBar android:id="@+id/progress" android:layout_width="1dp" android:layout_height="1dp"/>
            <View android:id="@+id/taskStatusCard" android:layout_width="1dp" android:layout_height="1dp"/>
            <TextView android:id="@+id/taskStatusText" android:layout_width="1dp" android:layout_height="1dp"/>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sessionDrawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="酸奶喵图标"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="酸奶喵"
                    android:textColor="@color/ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="你的生图工作台"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawerClose"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="×"
                android:textColor="@color/ink"
                android:textSize="25sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:text="最近"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawerSessionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp" />
        </ScrollView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_alt"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawerSettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="设置"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
